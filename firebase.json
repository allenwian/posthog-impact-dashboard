{
  "hosting": {
    "public": "web/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/impact",
        "function": {
          "functionId": "impact",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git"
      ]
    },
    {
      "source": "functions-py",
      "codebase": "pipeline",
      "runtime": "python312",
      "ignore": [
        "venv",
        "__pycache__",
        ".git"
      ],
      "predeploy": [
        "cp \"$PROJECT_DIR/pipeline/fetch_prs.py\" \"$PROJECT_DIR/pipeline/score.py\" \"$PROJECT_DIR/functions-py/\""
      ]
    }
  ]
}